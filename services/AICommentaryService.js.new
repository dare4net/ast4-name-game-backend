class AICommentaryService {
  static updatePlayerProfile(game, currentRoundIdx) {
    const round = game.roundResults[currentRoundIdx];
    const allScores = game.players.map(p => p.score).sort((a, b) => b - a);

    game.players.forEach(player => {
      if (!playerProfiles.has(player.id)) {
        playerProfiles.set(player.id, {
          scoreHistory: [],
          bonusHistory: [],
          letterPerformance: {},
          weakestCategories: new Set(),
          strongestCategories: new Set(),
          lastThreeRoundsDelta: 0,
          perfectRounds: 0,
          situation: 'NEUTRAL'
        });
      }

      const profile = playerProfiles.get(player.id);
      const roundScore = round.scores[player.id] || 0;
      
      // Update score history and calculate delta
      profile.scoreHistory.push(roundScore);
      const lastThree = profile.scoreHistory.slice(-3);
      profile.lastThreeRoundsDelta = lastThree.length > 1 ? 
        lastThree[lastThree.length - 1] - lastThree[0] : 0;

      // Track bonuses
      if (round.extraBonuses) {
        if (round.extraBonuses.fastestSubmission?.playerId === player.id) {
          profile.bonusHistory.push({ type: 'FASTEST', round: currentRoundIdx });
        }
        if (round.extraBonuses.longestWord?.playerId === player.id) {
          profile.bonusHistory.push({ type: 'LONGEST', round: currentRoundIdx });
        }
        if (round.extraBonuses.master?.playerId === player.id) {
          profile.bonusHistory.push({ type: 'MASTER', round: currentRoundIdx });
        }
      }

      // Calculate relative performance metrics
      const position = allScores.indexOf(player.score);
      const percentile = (position / allScores.length) * 100;
      
      // Calculate score differences
      const scoreGapToFirst = position === 0 ? 0 : allScores[0] - player.score;
      const scoreGapToLast = position === allScores.length - 1 ? 0 : player.score - allScores[allScores.length - 1];
      
      // Calculate relative deltas (compare player's improvement to others)
      const allDeltas = game.players.map(p => {
        const profile = playerProfiles.get(p.id);
        return profile?.lastThreeRoundsDelta || 0;
      });
      const avgDelta = allDeltas.reduce((a, b) => a + b, 0) / allDeltas.length;
      const relativeDelta = profile.lastThreeRoundsDelta - avgDelta;

      // Calculate performance consistency
      const recentScores = profile.scoreHistory.slice(-3);
      const scoreVariance = recentScores.length > 1 ? 
        Math.sqrt(recentScores.reduce((sum, score) => sum + Math.pow(score - (recentScores.reduce((a, b) => a + b, 0) / recentScores.length), 2), 0) / recentScores.length) : 0;

      // Determine situation and subcategory based on comprehensive analysis
      if (percentile <= 25) {
        profile.situation = 'WINNING';
        // DOMINANT if: maintaining lead AND improving faster than others OR huge lead
        if ((relativeDelta > 5 && scoreGapToFirst < 10) || scoreGapToFirst > 30) {
          profile.subCategory = 'DOMINANT';
        } else {
          profile.subCategory = 'CONSISTENT';
        }
      } else if (percentile >= 75) {
        profile.situation = 'LOSING';
        // PLUMMETING if: falling behind AND doing worse than others
        if (relativeDelta < -10 || (profile.lastThreeRoundsDelta < -15 && scoreVariance > 10)) {
          profile.subCategory = 'PLUMMETING';
        } else {
          profile.subCategory = 'STRUGGLING';
        }
      } else {
        // Middle pack analysis
        if (relativeDelta > 15 || (profile.lastThreeRoundsDelta > 20 && scoreGapToFirst < 20)) {
          // Strong comeback if improving much faster than others or closing gap to leader
          profile.situation = 'COMEBACK';
          profile.subCategory = 'STRONG';
        } else if (relativeDelta > 5 || profile.lastThreeRoundsDelta > 10) {
          // Potential comeback if showing improvement
          profile.situation = 'COMEBACK';
          profile.subCategory = 'POTENTIAL';
        } else if (scoreVariance < 5 && Math.abs(relativeDelta) < 5) {
          // Truly consistent if scores are stable and keeping pace with others
          profile.situation = 'NEUTRAL';
          profile.subCategory = 'CONSISTENT';
        } else {
          // Default to struggling if not meeting other criteria
          profile.situation = 'LOSING';
          profile.subCategory = 'STRUGGLING';
        }
      }
      
      // Track consistency
      profile.lastSituation = profile.currentSituation;
      profile.currentSituation = { main: profile.situation, sub: profile.subCategory };
    });
  }

  static generateCommentary(game, currentRoundIdx) {
    this.updatePlayerProfile(game, currentRoundIdx);
    const comments = new Map();
    const round = game.roundResults[currentRoundIdx];

    // Find strongest and weakest players for context
    const sortedPlayers = [...game.players].sort((a, b) => b.score - a.score);
    const strongestPlayer = sortedPlayers[0];
    const weakestPlayer = sortedPlayers[sortedPlayers.length - 1];

    // Get unused letters
    const usedLetters = new Set(game.roundResults.map(r => r.letter));
    const unusedLetters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
      .split('')
      .filter(l => !usedLetters.has(l));

    game.players.forEach(player => {
      const profile = playerProfiles.get(player.id);
      const situation = profile.situation;
      let commentary = '';

      // Build a dynamic commentary based on situation and analysis
      const params = {
        lowestPlayer: weakestPlayer.name,
        strongPlayer: strongestPlayer.name,
        goodLetter: unusedLetters[Math.floor(Math.random() * unusedLetters.length)]
      };

      // Get base commentary for main situation
      commentary += this.getRandomComment(situation, profile.subCategory, 'COMMENTS') + '\n\n';

      // Add 1-2 pieces of strategic advice
      const numAdvice = Math.random() > 0.5 ? 2 : 1;
      for (let i = 0; i < numAdvice; i++) {
        commentary += this.getRandomComment(situation, profile.subCategory, 'ADVICE', params) + ' ';
      }
      commentary += '\n\n';

      // Add an insight
      commentary += this.getRandomComment(situation, profile.subCategory, 'INSIGHTS', params) + '\n';

      // Add bonus achievements if any
      if (round.extraBonuses) {
        const { fastestSubmission, longestWord, rareWords, master } = round.extraBonuses;
        
        if (fastestSubmission?.playerId === player.id) {
          commentary += this.getRandomBonusComment('FASTEST', { playerName: player.name }) + ' ';
        }
        
        if (longestWord?.playerId === player.id) {
          commentary += this.getRandomBonusComment('LONGEST_WORD', { word: longestWord.word }) + ' ';
        }
        
        if (rareWords?.some(rw => rw.playerId === player.id)) {
          commentary += this.getRandomBonusComment('RARE_WORDS') + ' ';
        }
        
        if (master?.playerId === player.id) {
          commentary += this.getRandomBonusComment('MASTER', { letter: round.letter });
        }
      }

      comments.set(player.id, commentary.trim());
    });

    return comments;
  }

  static getRandomComment(situation, subCategory, type, params = {}) {
    // First try to get comments for the specific situation and subcategory
    let options = SITUATIONS[situation]?.[subCategory]?.[type];
    
    // If not found, try the CONSISTENT subcategory of the same situation
    if (!options && situation !== 'NEUTRAL') {
      options = SITUATIONS[situation]?.['CONSISTENT']?.[type];
    }
    
    // If still not found, fall back to NEUTRAL.CONSISTENT
    if (!options) {
      options = SITUATIONS['NEUTRAL']['CONSISTENT'][type];
    }
    
    if (!options || options.length === 0) {
      console.warn(`No comments found for ${situation}.${subCategory}.${type}, using default`);
      return "vibing fr fr 😎";
    }

    let comment = options[Math.floor(Math.random() * options.length)];
    
    // Replace any parameters in the comment
    Object.entries(params).forEach(([key, value]) => {
      comment = comment.replace(`{${key}}`, value);
    });
    
    return comment;
  }

  static getRandomBonusComment(bonusType, params = {}) {
    const comments = BONUS_COMMENTS[bonusType];
    let comment = comments[Math.floor(Math.random() * comments.length)];
    Object.entries(params).forEach(([key, value]) => {
      comment = comment.replace(`{${key}}`, value);
    });
    return comment;
  }

  static formatBonusComments(bonuses = [], params = {}) {
    if (bonuses.length === 0) return '';
    
    return '\n' + bonuses
      .map(bonus => this.getRandomBonusComment(bonus, params))
      .join(' + ');
  }
}

module.exports = AICommentaryService;
